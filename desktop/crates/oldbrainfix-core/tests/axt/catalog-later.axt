avro.schema˙2{
  "type": "record",
  "name": "Envelope",
  "namespace": "axt",
  "doc": "One AXT message. Defined in spec/envelope.md. The field order is part of the format: format is always the first field, signature always the last.",
  "fields": [
    {
      "name": "format",
      "type": "int",
      "doc": "Version of the envelope format. 1 for the envelope defined in spec/envelope.md. Every later envelope schema keeps this field first and of type int."
    },
    {
      "name": "kind",
      "type": {
        "type": "enum",
        "name": "Kind",
        "doc": "What the message is. Each kind is defined in the document named in spec/envelope.md, section 2.2. DEVICE_JOIN, DEVICE_ADD and DEVICE_REMOVE: the devices of one sender, spec/keys.md, section 5. CHANGE and RESYNC: records between the devices of one sender. FORWARD: a message of another app passed on between the devices of one sender. WITHDRAW: a record its sender no longer shares. PROPOSAL and PROPOSAL_REPLY: a change a receiver proposes to a record's sender, and the answer.",
        "symbols": [
          "MANIFEST",
          "OFFER",
          "ACCEPT",
          "DECLINE",
          "DATA",
          "DELETE",
          "ACK",
          "ERROR",
          "DEVICE_JOIN",
          "DEVICE_ADD",
          "DEVICE_REMOVE",
          "CHANGE",
          "RESYNC",
          "FORWARD",
          "WITHDRAW",
          "PROPOSAL",
          "PROPOSAL_REPLY"
        ]
      },
      "doc": "What the message is, and so which schema its body has."
    },
    {
      "name": "sender",
      "type": {
        "type": "fixed",
        "name": "PublicKey",
        "size": 32,
        "doc": "An Ed25519 public key in the encoding of RFC 8032. Defined in spec/keys.md."
      },
      "doc": "The Ed25519 public key of the sending device, which made the signature."
    },
    {
      "name": "record",
      "type": [
        "null",
        {
          "type": "record",
          "name": "RecordRef",
          "doc": "Which record, and which version of it, a message is about. Defined in spec/records.md.",
          "fields": [
            {
              "name": "id",
              "type": {
                "type": "string",
                "logicalType": "uuid"
              },
              "doc": "The record's stable id, a UUID in its 36-character lower-case text form."
            },
            {
              "name": "version",
              "type": "long",
              "doc": "The record's version. Defined in spec/records.md."
            }
          ]
        }
      ],
      "default": null,
      "doc": "The record the message is about; null for messages that are not about one record."
    },
    {
      "name": "body",
      "type": "bytes",
      "doc": "Empty, or one datum in Avro single-object encoding: the marker C3 01, the 8-byte little-endian CRC-64-AVRO fingerprint of the datum's writer schema, then the datum in Avro binary encoding."
    },
    {
      "name": "signature",
      "type": {
        "type": "fixed",
        "name": "Signature",
        "size": 64,
        "doc": "An Ed25519 signature. Defined in spec/keys.md."
      },
      "doc": "The sender's signature over the message. What it covers is defined in spec/keys.md."
    }
  ]
}
axt.schemas¬´[{"description":{"name":"appointment","doc":"An appointment: an event at a time and possibly a place, such as a visit to the vet.","texts":{"label":"Appointment","label_translations":{"de":"Termin"},"help":"An event at a time and possibly a place, such as a visit to the vet.","help_translations":{"de":"Ein Ereignis zu einer Zeit und vielleicht an einem Ort, etwa ein Besuch beim Tierarzt."},"emoji":"üìÜ"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.ObjectField":{"name":"axt.example.v1.Appointment","fields":[{"name":"title","doc":"What the appointment is, as plain text on one line.","texts":{"label":"Title","label_translations":{"de":"Titel"},"help":"What the appointment is, on one line.","help_translations":{"de":"Worum es beim Termin geht, in einer Zeile."},"emoji":"üè∑Ô∏è"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.StringField":{"default":"","min_length":null,"max_length":null,"pattern":null,"multiline":false,"preferred_length":null,"placeholder":"","example":""}}},{"name":"start","doc":"When the appointment starts, as a date and time on the wall clock, in a time zone or floating. For an all-day appointment, 00:00 of its first day, floating.","texts":{"label":"Start","label_translations":{"de":"Beginn"},"help":"When the appointment starts.","help_translations":{"de":"Wann der Termin beginnt."},"emoji":"üïò"},"required":true,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.DateTimeField":{"anchor":"LOCAL"}}},{"name":"end","doc":"When the appointment ends: the first moment after it, which is not part of it. It is in a time zone when start is, possibly another one, as for a flight, and floating when start is floating. For an all-day appointment, 00:00 of the day after its last day, floating. Null when no end is given; an all-day appointment without an end takes one day.","texts":{"label":"End","label_translations":{"de":"Ende"},"help":"When the appointment is over.","help_translations":{"de":"Wann der Termin vorbei ist."},"emoji":"üîö"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.DateTimeField":{"anchor":"LOCAL"}}},{"name":"all_day","doc":"True when the appointment takes whole days; start and end are then floating at 00:00, and only their days count.","texts":{"label":"All day","label_translations":{"de":"Ganzt√§gig"},"help":"On when the appointment takes whole days.","help_translations":{"de":"An, wenn der Termin ganze Tage dauert."},"emoji":"‚òÄÔ∏è"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.BooleanField":{"default":false}}},{"name":"location","doc":"Where the appointment takes place, as text, such as an address or a room. Empty when not given.","texts":{"label":"Location","label_translations":{"de":"Ort"},"help":"Where the appointment takes place, such as an address or a room.","help_translations":{"de":"Wo der Termin stattfindet, etwa eine Anschrift oder ein Raum."},"emoji":"üìç"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.StringField":{"default":"","min_length":null,"max_length":null,"pattern":null,"multiline":false,"preferred_length":null,"placeholder":"","example":""}}},{"name":"notes","doc":"Free notes on the appointment, as plain text; lines are separated by LF. Empty when there are none.","texts":{"label":"Notes","label_translations":{"de":"Notizen"},"help":"Anything else about the appointment.","help_translations":{"de":"Alles Weitere zum Termin."},"emoji":"üìù"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.StringField":{"default":"","min_length":null,"max_length":null,"pattern":null,"multiline":true,"preferred_length":null,"placeholder":"","example":""}}},{"name":"reminders","doc":"When the user wants to be reminded, each as a duration added to start as spec/time.md, section 7.2, says: negative before start, such as -PT15M for 15 minutes before or -P1D for the day before at the same time on the wall clock, 0 at start, and positive after it. Empty when there are no reminders.","texts":{"label":"Reminders","label_translations":{"de":"Erinnerungen"},"help":"When to be reminded, each before or after the start.","help_translations":{"de":"Wann erinnert werden soll, jeweils vor oder nach dem Beginn."},"emoji":"‚è∞"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.ListField":{"items":{"name":"reminders","doc":"When the user wants to be reminded, each as a duration added to start as spec/time.md, section 7.2, says: negative before start, such as -PT15M for 15 minutes before or -P1D for the day before at the same time on the wall clock, 0 at start, and positive after it. Empty when there are no reminders.","texts":{"label":"","label_translations":{},"help":"","help_translations":{},"emoji":""},"required":true,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.DurationField":{}}}}}},{"name":"relations","doc":"The relations of the record to other records and to things outside AXT (spec/types.md, section 8), in the order the user gave them. Empty when it has none.","texts":{"label":"Relations","label_translations":{"de":"Verkn√ºpfungen"},"help":"Entries and other things this one is linked to, such as the pets an appointment is for.","help_translations":{"de":"Eintr√§ge und anderes, mit denen dieser verkn√ºpft ist, etwa die Tiere, f√ºr die ein Termin ist."},"emoji":"üîó"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.RelationField":{}}},{"name":"extensions","doc":"The extensions of the record: records of the apps' own types that add fields of their own to it (spec/fields.md, section 12), at most one of each type. Empty when it has none.","texts":{"label":"Extensions","label_translations":{"de":"Erweiterungen"},"help":"Further fields that apps add to this entry.","help_translations":{"de":"Weitere Felder, die Apps diesem Eintrag hinzuf√ºgen."},"emoji":"üß©"},"required":false,"order":null,"group":"","sensitive":false,"advanced":true,"kind":{"axt.ExtensionField":{}}}],"groups":[],"version":1,"title":"title"}}},"schema":{"axt.version":1,"doc":"An appointment: an event at a time and possibly a place, such as a visit to the vet.","fields":[{"default":"","doc":"What the appointment is, as plain text on one line.","name":"title","type":"string"},{"doc":"When the appointment starts, as a date and time on the wall clock, in a time zone or floating. For an all-day appointment, 00:00 of its first day, floating.","name":"start","type":{"doc":"A date and time on the wall clock, to the millisecond, either in a time zone of the IANA time zone database, with the offset from UTC and the instant as the writer's zone rules gave them, or floating, on the wall clock of wherever the user is, without zone, offset and instant. Defined in spec/time.md. Its schema never changes.","fields":[{"doc":"The year of the proleptic Gregorian calendar, 1 to 9999.","name":"year","type":"int"},{"doc":"The month, 1 (January) to 12 (December).","name":"month","type":"int"},{"doc":"The day of the month, 1 to the number of days of that month in that year.","name":"day","type":"int"},{"doc":"The hour on the wall clock, 0 to 23.","name":"hour","type":"int"},{"doc":"The minute, 0 to 59.","name":"minute","type":"int"},{"doc":"The second, 0 to 59; a leap second is not written as 60.","name":"second","type":"int"},{"doc":"The millisecond, 0 to 999.","name":"millisecond","type":"int"},{"default":null,"doc":"The name of the time zone in the IANA time zone database, such as Europe/Berlin. Null for a floating time; then offset_seconds and instant_ms are null as well.","name":"zone","type":["null","string"]},{"default":null,"doc":"The offset of the wall clock from UTC, in seconds, -64800 to 64800, as the writer's rules of the zone gave it at the instant, such as 3600 for 01:00 east of UTC. Null for a floating time, and only then.","name":"offset_seconds","type":["null","int"]},{"default":null,"doc":"The instant, in milliseconds since 1970-01-01T00:00:00Z without leap seconds: the wall clock read as if it were UTC, minus offset_seconds. Null for a floating time, and only then.","name":"instant_ms","type":["null","long"]}],"name":"DateTime","namespace":"axt","type":"record"}},{"default":null,"doc":"When the appointment ends: the first moment after it, which is not part of it. It is in a time zone when start is, possibly another one, as for a flight, and floating when start is floating. For an all-day appointment, 00:00 of the day after its last day, floating. Null when no end is given; an all-day appointment without an end takes one day.","name":"end","type":["null","axt.DateTime"]},{"default":false,"doc":"True when the appointment takes whole days; start and end are then floating at 00:00, and only their days count.","name":"all_day","type":"boolean"},{"default":"","doc":"Where the appointment takes place, as text, such as an address or a room. Empty when not given.","name":"location","type":"string"},{"default":"","doc":"Free notes on the appointment, as plain text; lines are separated by LF. Empty when there are none.","name":"notes","type":"string"},{"default":[],"doc":"When the user wants to be reminded, each as a duration added to start as spec/time.md, section 7.2, says: negative before start, such as -PT15M for 15 minutes before or -P1D for the day before at the same time on the wall clock, 0 at start, and positive after it. Empty when there are no reminders.","name":"reminders","type":{"items":{"doc":"A length of time in three parts that are not converted into each other: calendar months, calendar days and elapsed milliseconds, as an INTERVAL of SQL. P1M2DT3H is 1 month, 2 days and 10800000 milliseconds; -PT15M is -900000 milliseconds. The parts that are not 0 all have the same sign. Added to a date and time, the months come first, then the days, then the milliseconds. Defined in spec/time.md. Its schema never changes.","fields":[{"doc":"The number of calendar months, negative for a length back in time. A year is 12 months.","name":"months","type":"int"},{"doc":"The number of calendar days, negative for a length back in time. A day on the wall clock, which may last 23 or 25 hours where the offset changes; a week is 7 days.","name":"days","type":"int"},{"doc":"The number of elapsed milliseconds, negative for a length back in time. Hours, minutes and seconds are carried here: an hour is 3600000 milliseconds, and 24 hours are not converted into a day.","name":"millis","type":"long"}],"name":"Duration","namespace":"axt","type":"record"},"type":"array"}},{"default":[],"doc":"The relations of the record to other records and to things outside AXT (spec/types.md, section 8), in the order the user gave them. Empty when it has none.","name":"relations","type":{"items":{"axt.emoji":"üîó","axt.help":"A link to another entry or to something outside, such as the pet an appointment is for.","axt.help_translations":{"de":"Eine Verkn√ºpfung mit einem anderen Eintrag oder mit etwas au√üerhalb, etwa mit dem Tier, f√ºr das ein Termin ist."},"axt.label":"Relation","axt.label_translations":{"de":"Verkn√ºpfung"},"doc":"A relation: a link from the record that holds it to another record or to a thing outside AXT, of a kind, with information about the link. Defined in spec/fields.md, section 11.","fields":[{"axt.advanced":true,"axt.emoji":"üÜî","axt.help":"The id of this relation.","axt.help_translations":{"de":"Die ID dieser Verkn√ºpfung."},"axt.label":"Relation id","axt.label_translations":{"de":"Verkn√ºpfungs-ID"},"doc":"The id of the relation, a UUID in lower-case hexadecimal, unique among the relations of the record that holds it and kept for as long as the relation exists.","name":"id","type":{"logicalType":"uuid","type":"string"}},{"axt.emoji":"üîñ","axt.help":"What kind of link this is.","axt.help_translations":{"de":"Welche Art von Verkn√ºpfung das ist."},"axt.label":"Kind","axt.label_translations":{"de":"Art"},"default":"axt.related","doc":"The kind of the relation, a name in a namespace, written like the full name of a type, such as org.example.catalog.patient. axt.related, the only kind AXT defines, says only that the two are related. A receiver shows a kind it does not know as a relation of that name.","name":"kind","type":"string"},{"axt.emoji":"üéØ","axt.help":"What is linked.","axt.help_translations":{"de":"Was verkn√ºpft ist."},"axt.label":"Target","axt.label_translations":{"de":"Ziel"},"doc":"What the relation points at: a record, or a thing outside AXT.","name":"target","type":[{"axt.emoji":"üìÑ","axt.help":"An entry of this app or of another.","axt.help_translations":{"de":"Ein Eintrag dieser App oder einer anderen."},"axt.label":"Entry","axt.label_translations":{"de":"Eintrag"},"doc":"A record as the target of a relation: by its id and its sender.","fields":[{"axt.advanced":true,"axt.emoji":"üÜî","axt.help":"The id of the linked entry.","axt.help_translations":{"de":"Die ID des verkn√ºpften Eintrags."},"axt.label":"Entry id","axt.label_translations":{"de":"Eintrags-ID"},"doc":"The id of the target record.","name":"id","type":{"logicalType":"uuid","type":"string"}},{"axt.advanced":true,"axt.emoji":"üîë","axt.help":"The app the linked entry comes from.","axt.help_translations":{"de":"Die App, von der der verkn√ºpfte Eintrag kommt."},"axt.label":"Sender","axt.label_translations":{"de":"Absender"},"default":null,"doc":"A key of the device set of the target record's sender. Null when the target is a record of the sender of the record that holds the relation.","name":"sender","type":["null",{"doc":"An Ed25519 public key in the encoding of RFC 8032. Defined in spec/keys.md.","name":"RelationRecordTargetSender","size":32,"type":"fixed"}]},{"axt.advanced":true,"axt.emoji":"üß©","axt.help":"The type of the linked entry.","axt.help_translations":{"de":"Der Typ des verkn√ºpften Eintrags."},"axt.label":"Type","axt.label_translations":{"de":"Typ"},"default":"","doc":"The full name of the target record's type, which holds its major version, such as axt.example.v1.Pet. Empty when not known.","name":"type","type":"string"},{"axt.emoji":"üí¨","axt.help":"What to show for the linked entry.","axt.help_translations":{"de":"Was f√ºr den verkn√ºpften Eintrag angezeigt wird."},"axt.label":"Display text","axt.label_translations":{"de":"Anzeigetext"},"default":"","doc":"A text to show for the target while the record itself is not at hand, such as its title. Empty when there is none.","name":"text","type":"string"}],"name":"RelationRecordTarget","type":"record"},{"axt.emoji":"üåê","axt.help":"Something that is not an entry, such as a web page.","axt.help_translations":{"de":"Etwas, das kein Eintrag ist, etwa eine Webseite."},"axt.label":"Outside thing","axt.label_translations":{"de":"Etwas au√üerhalb"},"doc":"A thing outside AXT as the target of a relation: by a URI.","fields":[{"axt.emoji":"üîó","axt.format":"uri","axt.help":"The address of the linked thing.","axt.help_translations":{"de":"Die Adresse des verkn√ºpften Dings."},"axt.label":"URI","axt.label_translations":{"de":"URI"},"doc":"A URI of RFC 3986 that names the thing, of any scheme, such as https: or urn:. Not empty.","name":"uri","type":"string"},{"axt.emoji":"üí¨","axt.help":"What to show for the linked thing.","axt.help_translations":{"de":"Was f√ºr das verkn√ºpfte Ding angezeigt wird."},"axt.label":"Display text","axt.label_translations":{"de":"Anzeigetext"},"default":"","doc":"A text to show for the thing, such as its name. Empty when there is none.","name":"text","type":"string"}],"name":"RelationOutsideTarget","type":"record"}]},{"axt.emoji":"üìù","axt.help":"Something about this link.","axt.help_translations":{"de":"Etwas zu dieser Verkn√ºpfung."},"axt.label":"Note","axt.label_translations":{"de":"Notiz"},"axt.multiline":true,"default":"","doc":"Free text about the link. Empty when there is none.","name":"note","type":"string"},{"axt.emoji":"‚ñ∂Ô∏è","axt.help":"When the link begins.","axt.help_translations":{"de":"Wann die Verkn√ºpfung beginnt."},"axt.label":"From","axt.label_translations":{"de":"Ab"},"default":null,"doc":"When the link begins, such as the day a pet came to its keeper. Null when it has no beginning or it is not known.","name":"start","type":["null","axt.DateTime"]},{"axt.emoji":"‚èπÔ∏è","axt.help":"When the link ends.","axt.help_translations":{"de":"Wann die Verkn√ºpfung endet."},"axt.label":"Until","axt.label_translations":{"de":"Bis"},"default":null,"doc":"The first moment after the link, as for the end of an appointment. Null when it has no end or it is not known.","name":"end","type":["null","axt.DateTime"]},{"axt.advanced":true,"axt.emoji":"üóÇÔ∏è","axt.help":"Further details of the link.","axt.help_translations":{"de":"Weitere Angaben zur Verkn√ºpfung."},"axt.label":"Details","axt.label_translations":{"de":"Details"},"default":{},"doc":"Further values that the kind of the relation needs, by names its kind gives them. Empty when there are none.","name":"attributes","type":{"type":"map","values":"string"}}],"name":"Relation","namespace":"axt","type":"record"},"type":"array"}},{"default":[],"doc":"The extensions of the record: records of the apps' own types that add fields of their own to it (spec/fields.md, section 12), at most one of each type. Empty when it has none.","name":"extensions","type":{"items":{"axt.emoji":"üß©","axt.help":"Further fields that an app adds to this entry.","axt.help_translations":{"de":"Weitere Felder, die eine App diesem Eintrag hinzuf√ºgt."},"axt.label":"Extension","axt.label_translations":{"de":"Erweiterung"},"doc":"An extension: one record of an app's own type that the app adds to a record of another type, such as the fields of its own that a cat-a-log adds to a Pet, held as the bytes of its single-object encoding. Defined in spec/fields.md, section 12.","fields":[{"axt.advanced":true,"axt.emoji":"üîñ","axt.help":"The type of this extension.","axt.help_translations":{"de":"Der Typ dieser Erweiterung."},"axt.label":"Extension type","axt.label_translations":{"de":"Erweiterungstyp"},"doc":"The full name of the extension's record type, such as org.example.catalog.CatExtension, which holds its major version, of at most 256 bytes; at most one extension of a name in a list.","name":"name","type":"string"},{"axt.advanced":true,"axt.emoji":"üì¶","axt.help":"The values of this extension.","axt.help_translations":{"de":"Die Werte dieser Erweiterung."},"axt.label":"Extension data","axt.label_translations":{"de":"Erweiterungsdaten"},"doc":"The extension's record in single-object encoding: the marker C3 01, the fingerprint of its writer schema as 8 bytes in little-endian order, and the record's Avro binary encoding. Passed on unchanged by an app that does not know the type.","name":"data","type":"bytes"}],"name":"Extension","namespace":"axt","type":"record"},"type":"array"}}],"name":"Appointment","namespace":"axt.example.v1","type":"record"}},{"description":{"name":"note","doc":"A note: a piece of text the user wrote down, with a title and tags.","texts":{"label":"Note","label_translations":{"de":"Notiz"},"help":"A piece of text written down, with a title and tags.","help_translations":{"de":"Ein aufgeschriebener Text mit Titel und Schlagw√∂rtern."},"emoji":"üóíÔ∏è"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.ObjectField":{"name":"axt.example.v1.Note","fields":[{"name":"title","doc":"The note's title, as plain text on one line. Empty when the note has none.","texts":{"label":"Title","label_translations":{"de":"Titel"},"help":"The note's title, on one line.","help_translations":{"de":"Der Titel der Notiz, in einer Zeile."},"emoji":"üè∑Ô∏è"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.StringField":{"default":"","min_length":null,"max_length":null,"pattern":null,"multiline":false,"preferred_length":null,"placeholder":"","example":""}}},{"name":"text","doc":"The note's content, written in the format named by the field format. Empty when the note has only a title.","texts":{"label":"Text","label_translations":{"de":"Text"},"help":"The content, as plain text or Markdown, as Format says.","help_translations":{"de":"Der Inhalt, als einfacher Text oder Markdown, wie unter Format angegeben."},"emoji":"üìù"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.StringField":{"default":"","min_length":null,"max_length":null,"pattern":null,"multiline":true,"preferred_length":null,"placeholder":"","example":""}}},{"name":"format","doc":"How the field text is written.","texts":{"label":"Format","label_translations":{"de":"Format"},"help":"How the text is written.","help_translations":{"de":"Wie der Text geschrieben ist."},"emoji":"üî§"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.EnumField":{"name":"NoteFormat","symbols":[{"symbol":"PLAIN","texts":{"label":"Plain text","label_translations":{"de":"Einfacher Text"},"help":"","help_translations":{},"emoji":"üìÑ"}},{"symbol":"MARKDOWN","texts":{"label":"Markdown","label_translations":{"de":"Markdown"},"help":"","help_translations":{},"emoji":"‚ìÇÔ∏è"}}],"fallback":"PLAIN","default":"PLAIN"}}},{"name":"created","doc":"When the note was written. Null when not known.","texts":{"label":"Created","label_translations":{"de":"Erstellt"},"help":"When the note was written.","help_translations":{"de":"Wann die Notiz geschrieben wurde."},"emoji":"üÜï"},"required":false,"order":null,"group":"","sensitive":false,"advanced":true,"kind":{"axt.DateTimeField":{"anchor":"INSTANT"}}},{"name":"updated","doc":"When the note's content last changed. Null when not known.","texts":{"label":"Updated","label_translations":{"de":"Ge√§ndert"},"help":"When the note's content last changed.","help_translations":{"de":"Wann der Inhalt der Notiz zuletzt ge√§ndert wurde."},"emoji":"üîÑ"},"required":false,"order":null,"group":"","sensitive":false,"advanced":true,"kind":{"axt.DateTimeField":{"anchor":"INSTANT"}}},{"name":"tags","doc":"Tags the user gave the note, in the user's order and without duplicates; each a word or short phrase without a leading #. Empty when there are none.","texts":{"label":"Tags","label_translations":{"de":"Schlagw√∂rter"},"help":"Words or short phrases to find the note by, without a leading #.","help_translations":{"de":"W√∂rter oder kurze Ausdr√ºcke, √ºber die sich die Notiz finden l√§sst, ohne f√ºhrendes #."},"emoji":"üîñ"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.ListField":{"items":{"name":"tags","doc":"Tags the user gave the note, in the user's order and without duplicates; each a word or short phrase without a leading #. Empty when there are none.","texts":{"label":"","label_translations":{},"help":"","help_translations":{},"emoji":""},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.StringField":{"default":"","min_length":null,"max_length":null,"pattern":null,"multiline":false,"preferred_length":20,"placeholder":"","example":""}}}}}},{"name":"relations","doc":"The relations of the record to other records and to things outside AXT (spec/types.md, section 8), in the order the user gave them. Empty when it has none.","texts":{"label":"Relations","label_translations":{"de":"Verkn√ºpfungen"},"help":"Entries and other things this one is linked to, such as the pets an appointment is for.","help_translations":{"de":"Eintr√§ge und anderes, mit denen dieser verkn√ºpft ist, etwa die Tiere, f√ºr die ein Termin ist."},"emoji":"üîó"},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.RelationField":{}}},{"name":"extensions","doc":"The extensions of the record: records of the apps' own types that add fields of their own to it (spec/fields.md, section 12), at most one of each type. Empty when it has none.","texts":{"label":"Extensions","label_translations":{"de":"Erweiterungen"},"help":"Further fields that apps add to this entry.","help_translations":{"de":"Weitere Felder, die Apps diesem Eintrag hinzuf√ºgen."},"emoji":"üß©"},"required":false,"order":null,"group":"","sensitive":false,"advanced":true,"kind":{"axt.ExtensionField":{}}}],"groups":[],"version":1,"title":"title"}}},"schema":{"axt.version":1,"doc":"A note: a piece of text the user wrote down, with a title and tags.","fields":[{"default":"","doc":"The note's title, as plain text on one line. Empty when the note has none.","name":"title","type":"string"},{"default":"","doc":"The note's content, written in the format named by the field format. Empty when the note has only a title.","name":"text","type":"string"},{"default":"PLAIN","doc":"How the field text is written.","name":"format","type":{"default":"PLAIN","doc":"How the field text is written.","name":"NoteFormat","symbols":["PLAIN","MARKDOWN"],"type":"enum"}},{"default":null,"doc":"When the note was written. Null when not known.","name":"created","type":["null",{"doc":"A date and time on the wall clock, to the millisecond, either in a time zone of the IANA time zone database, with the offset from UTC and the instant as the writer's zone rules gave them, or floating, on the wall clock of wherever the user is, without zone, offset and instant. Defined in spec/time.md. Its schema never changes.","fields":[{"doc":"The year of the proleptic Gregorian calendar, 1 to 9999.","name":"year","type":"int"},{"doc":"The month, 1 (January) to 12 (December).","name":"month","type":"int"},{"doc":"The day of the month, 1 to the number of days of that month in that year.","name":"day","type":"int"},{"doc":"The hour on the wall clock, 0 to 23.","name":"hour","type":"int"},{"doc":"The minute, 0 to 59.","name":"minute","type":"int"},{"doc":"The second, 0 to 59; a leap second is not written as 60.","name":"second","type":"int"},{"doc":"The millisecond, 0 to 999.","name":"millisecond","type":"int"},{"default":null,"doc":"The name of the time zone in the IANA time zone database, such as Europe/Berlin. Null for a floating time; then offset_seconds and instant_ms are null as well.","name":"zone","type":["null","string"]},{"default":null,"doc":"The offset of the wall clock from UTC, in seconds, -64800 to 64800, as the writer's rules of the zone gave it at the instant, such as 3600 for 01:00 east of UTC. Null for a floating time, and only then.","name":"offset_seconds","type":["null","int"]},{"default":null,"doc":"The instant, in milliseconds since 1970-01-01T00:00:00Z without leap seconds: the wall clock read as if it were UTC, minus offset_seconds. Null for a floating time, and only then.","name":"instant_ms","type":["null","long"]}],"name":"DateTime","namespace":"axt","type":"record"}]},{"default":null,"doc":"When the note's content last changed. Null when not known.","name":"updated","type":["null","axt.DateTime"]},{"default":[],"doc":"Tags the user gave the note, in the user's order and without duplicates; each a word or short phrase without a leading #. Empty when there are none.","name":"tags","type":{"items":"string","type":"array"}},{"default":[],"doc":"The relations of the record to other records and to things outside AXT (spec/types.md, section 8), in the order the user gave them. Empty when it has none.","name":"relations","type":{"items":{"axt.emoji":"üîó","axt.help":"A link to another entry or to something outside, such as the pet an appointment is for.","axt.help_translations":{"de":"Eine Verkn√ºpfung mit einem anderen Eintrag oder mit etwas au√üerhalb, etwa mit dem Tier, f√ºr das ein Termin ist."},"axt.label":"Relation","axt.label_translations":{"de":"Verkn√ºpfung"},"doc":"A relation: a link from the record that holds it to another record or to a thing outside AXT, of a kind, with information about the link. Defined in spec/fields.md, section 11.","fields":[{"axt.advanced":true,"axt.emoji":"üÜî","axt.help":"The id of this relation.","axt.help_translations":{"de":"Die ID dieser Verkn√ºpfung."},"axt.label":"Relation id","axt.label_translations":{"de":"Verkn√ºpfungs-ID"},"doc":"The id of the relation, a UUID in lower-case hexadecimal, unique among the relations of the record that holds it and kept for as long as the relation exists.","name":"id","type":{"logicalType":"uuid","type":"string"}},{"axt.emoji":"üîñ","axt.help":"What kind of link this is.","axt.help_translations":{"de":"Welche Art von Verkn√ºpfung das ist."},"axt.label":"Kind","axt.label_translations":{"de":"Art"},"default":"axt.related","doc":"The kind of the relation, a name in a namespace, written like the full name of a type, such as org.example.catalog.patient. axt.related, the only kind AXT defines, says only that the two are related. A receiver shows a kind it does not know as a relation of that name.","name":"kind","type":"string"},{"axt.emoji":"üéØ","axt.help":"What is linked.","axt.help_translations":{"de":"Was verkn√ºpft ist."},"axt.label":"Target","axt.label_translations":{"de":"Ziel"},"doc":"What the relation points at: a record, or a thing outside AXT.","name":"target","type":[{"axt.emoji":"üìÑ","axt.help":"An entry of this app or of another.","axt.help_translations":{"de":"Ein Eintrag dieser App oder einer anderen."},"axt.label":"Entry","axt.label_translations":{"de":"Eintrag"},"doc":"A record as the target of a relation: by its id and its sender.","fields":[{"axt.advanced":true,"axt.emoji":"üÜî","axt.help":"The id of the linked entry.","axt.help_translations":{"de":"Die ID des verkn√ºpften Eintrags."},"axt.label":"Entry id","axt.label_translations":{"de":"Eintrags-ID"},"doc":"The id of the target record.","name":"id","type":{"logicalType":"uuid","type":"string"}},{"axt.advanced":true,"axt.emoji":"üîë","axt.help":"The app the linked entry comes from.","axt.help_translations":{"de":"Die App, von der der verkn√ºpfte Eintrag kommt."},"axt.label":"Sender","axt.label_translations":{"de":"Absender"},"default":null,"doc":"A key of the device set of the target record's sender. Null when the target is a record of the sender of the record that holds the relation.","name":"sender","type":["null",{"doc":"An Ed25519 public key in the encoding of RFC 8032. Defined in spec/keys.md.","name":"RelationRecordTargetSender","size":32,"type":"fixed"}]},{"axt.advanced":true,"axt.emoji":"üß©","axt.help":"The type of the linked entry.","axt.help_translations":{"de":"Der Typ des verkn√ºpften Eintrags."},"axt.label":"Type","axt.label_translations":{"de":"Typ"},"default":"","doc":"The full name of the target record's type, which holds its major version, such as axt.example.v1.Pet. Empty when not known.","name":"type","type":"string"},{"axt.emoji":"üí¨","axt.help":"What to show for the linked entry.","axt.help_translations":{"de":"Was f√ºr den verkn√ºpften Eintrag angezeigt wird."},"axt.label":"Display text","axt.label_translations":{"de":"Anzeigetext"},"default":"","doc":"A text to show for the target while the record itself is not at hand, such as its title. Empty when there is none.","name":"text","type":"string"}],"name":"RelationRecordTarget","type":"record"},{"axt.emoji":"üåê","axt.help":"Something that is not an entry, such as a web page.","axt.help_translations":{"de":"Etwas, das kein Eintrag ist, etwa eine Webseite."},"axt.label":"Outside thing","axt.label_translations":{"de":"Etwas au√üerhalb"},"doc":"A thing outside AXT as the target of a relation: by a URI.","fields":[{"axt.emoji":"üîó","axt.format":"uri","axt.help":"The address of the linked thing.","axt.help_translations":{"de":"Die Adresse des verkn√ºpften Dings."},"axt.label":"URI","axt.label_translations":{"de":"URI"},"doc":"A URI of RFC 3986 that names the thing, of any scheme, such as https: or urn:. Not empty.","name":"uri","type":"string"},{"axt.emoji":"üí¨","axt.help":"What to show for the linked thing.","axt.help_translations":{"de":"Was f√ºr das verkn√ºpfte Ding angezeigt wird."},"axt.label":"Display text","axt.label_translations":{"de":"Anzeigetext"},"default":"","doc":"A text to show for the thing, such as its name. Empty when there is none.","name":"text","type":"string"}],"name":"RelationOutsideTarget","type":"record"}]},{"axt.emoji":"üìù","axt.help":"Something about this link.","axt.help_translations":{"de":"Etwas zu dieser Verkn√ºpfung."},"axt.label":"Note","axt.label_translations":{"de":"Notiz"},"axt.multiline":true,"default":"","doc":"Free text about the link. Empty when there is none.","name":"note","type":"string"},{"axt.emoji":"‚ñ∂Ô∏è","axt.help":"When the link begins.","axt.help_translations":{"de":"Wann die Verkn√ºpfung beginnt."},"axt.label":"From","axt.label_translations":{"de":"Ab"},"default":null,"doc":"When the link begins, such as the day a pet came to its keeper. Null when it has no beginning or it is not known.","name":"start","type":["null","axt.DateTime"]},{"axt.emoji":"‚èπÔ∏è","axt.help":"When the link ends.","axt.help_translations":{"de":"Wann die Verkn√ºpfung endet."},"axt.label":"Until","axt.label_translations":{"de":"Bis"},"default":null,"doc":"The first moment after the link, as for the end of an appointment. Null when it has no end or it is not known.","name":"end","type":["null","axt.DateTime"]},{"axt.advanced":true,"axt.emoji":"üóÇÔ∏è","axt.help":"Further details of the link.","axt.help_translations":{"de":"Weitere Angaben zur Verkn√ºpfung."},"axt.label":"Details","axt.label_translations":{"de":"Details"},"default":{},"doc":"Further values that the kind of the relation needs, by names its kind gives them. Empty when there are none.","name":"attributes","type":{"type":"map","values":"string"}}],"name":"Relation","namespace":"axt","type":"record"},"type":"array"}},{"default":[],"doc":"The extensions of the record: records of the apps' own types that add fields of their own to it (spec/fields.md, section 12), at most one of each type. Empty when it has none.","name":"extensions","type":{"items":{"axt.emoji":