 cat-a-log adds to a Pet, held as the bytes of its single-object encoding. Defined in spec/fields.md, section 12.","fields":[{"axt.advanced":true,"axt.emoji":"ðŸ”–","axt.help":"The type of this extension.","axt.help_translations":{"de":"Der Typ dieser Erweiterung."},"axt.label":"Extension type","axt.label_translations":{"de":"Erweiterungstyp"},"doc":"The full name of the extension's record type, such as org.example.catalog.CatExtension, which holds its major version, of at most 256 bytes; at most one extension of a name in a list.","name":"name","type":"string"},{"axt.advanced":true,"axt.emoji":"ðŸ“¦","axt.help":"The values of this extension.","axt.help_translations":{"de":"Die Werte dieser Erweiterung."},"axt.label":"Extension data","axt.label_translations":{"de":"Erweiterungsdaten"},"doc":"The extension's record in single-object encoding: the marker C3 01, the fingerprint of its writer schema as 8 bytes in little-endian order, and the record's Avro binary encoding. Passed on unchanged by an app that does not know the type.","name":"data","type":"bytes"}],"name":"Extension","namespace":"axt","type":"record"},"type":"array"}}],"name":"Task","namespace":"axt.example.v1","type":"record"}},{"description":{"name":"memo","doc":"A memo.","texts":{"label":"","label_translations":{},"help":"","help_translations":{},"emoji":""},"required":false,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.ObjectField":{"name":"org.example.Memo","fields":[{"name":"text","doc":"The text.","texts":{"label":"","label_translations":{},"help":"","help_translations":{},"emoji":""},"required":true,"order":null,"group":"","sensitive":false,"advanced":false,"kind":{"axt.StringField":{"default":null,"min_length":null,"max_length":null,"pattern":null,"multiline":false,"preferred_length":null,"placeholder":"","example":""}}}],"groups":[],"version":1,"title":""}}},"schema":{"axt.version":1,"doc":"A memo.","fields":[{"doc":"The text.","name":"text","type":"string"}],"name":"Memo"