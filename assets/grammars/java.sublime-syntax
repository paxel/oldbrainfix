%YAML 1.2
---
# Old Brain Fix (obf-1036): written for this app, MIT OR Apache-2.0 as the app.
name: Java
scope: source.java
file_extensions: [java]

variables:
  ident: '[A-Za-z_$][\w$]*'
  esc: '\\(?:u+[0-9a-fA-F]{4}|[0-7]{1,3}|.)'

contexts:
  main:
    - match: '//.*'
      scope: comment.line.double-slash.java
    - match: '/\*'
      push: block_comment
    - match: '"""'
      push: text_block
    - match: '"'
      push: string
    - match: '''(?:{{esc}}|[^\\''\n])'''
      scope: string.quoted.single.char.java
    - match: '@(?!interface\b){{ident}}(?:\.{{ident}})*'
      scope: variable.function.annotation.java
    - match: '\b(class|interface|enum|record)\s+({{ident}})'
      captures:
        1: keyword.declaration.java
        2: entity.name.class.java
    - match: '@interface\b'
      scope: keyword.declaration.java
    - match: '\b(?:if|else|for|while|do|switch|case|default|break|continue|return|throw|throws|try|catch|finally|new|instanceof|import|package|extends|implements|permits|assert|yield)\b'
      scope: keyword.control.java
    - match: '\b(?:class|interface|enum|record|var)\b'
      scope: keyword.declaration.java
    - match: '\b(?:public|private|protected|static|final|abstract|synchronized|volatile|transient|native|strictfp|sealed|non-sealed|default)\b'
      scope: storage.modifier.java
    - match: '\b(?:true|false|null)\b'
      scope: constant.language.java
    - match: '\b(?:this|super)\b'
      scope: variable.language.java
    - match: '\b(?:void|boolean|byte|char|short|int|long|float|double)\b'
      scope: storage.type.primitive.java
    - match: '\b[A-Z][a-z]\w*'
      scope: support.class.java
    - match: '\b(?:0[xX][0-9a-fA-F_]+[lL]?|0[bB][01_]+[lL]?|\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d+)?[lLfFdD]?|\.\d[\d_]*(?:[eE][+-]?\d+)?[fFdD]?)'
      scope: constant.numeric.java
    - match: '\b{{ident}}(?=\s*\()'
      scope: variable.function.java
    - match: '->|::|&&|\|\||\+\+|--|>>>?=?|<<=?|[-+*/%<>=!&|^~?:]=?'
      scope: keyword.operator.java

  block_comment:
    - meta_scope: comment.block.java
    - match: '\*/'
      pop: true

  string:
    - meta_scope: string.quoted.double.java
    - match: '"|$'
      pop: true
    - match: '{{esc}}'
      scope: constant.character.escape.java

  text_block:
    - meta_scope: string.quoted.triple.java
    - match: '"""'
      pop: true
    - match: '{{esc}}'
      scope: constant.character.escape.java
