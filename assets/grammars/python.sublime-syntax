%YAML 1.2
---
# Old Brain Fix (obf-1036): written for this app, MIT OR Apache-2.0 as the app.
name: Python
scope: source.python
file_extensions: [py, python, pyw, pyi]
first_line_match: '^#!\s*/\S*(?:/|\benv\s+(?:-\S+\s+)?)python[\d.]*\b'

variables:
  ident: '[A-Za-z_]\w*'
  fmt: '\b(?:[fF][rR]?|[rR][fF]|[tT])'
  raw: '\b(?:[rR][bB]?|[bB][rR])'
  plain: '(?:\b[uUbB])?'

contexts:
  main:
    - match: '#.*'
      scope: comment.line.number-sign.python
    - include: strings
    - match: '^\s*(@)([\w.]+)'
      captures:
        1: punctuation.definition.annotation.python
        2: variable.function.decorator.python
    - match: '\b(def)\s+({{ident}})'
      captures:
        1: keyword.declaration.function.python
        2: entity.name.function.python
    - match: '\b(class)\s+({{ident}})'
      captures:
        1: keyword.declaration.class.python
        2: entity.name.class.python
    - match: '\b(?:and|or|not|in|is)\b'
      scope: keyword.operator.logical.python
    - match: '\b(?:if|elif|else|for|while|break|continue|return|pass|raise|try|except|finally|with|as|yield|await|async|lambda|del|global|nonlocal|assert|import|from|def|class)\b'
      scope: keyword.control.python
    - match: '\b(?:True|False|None|NotImplemented|Ellipsis)\b|\.\.\.'
      scope: constant.language.python
    - match: '\b(?:self|cls)\b'
      scope: variable.language.python
    - match: '\b(?:int|float|complex|str|bytes|bytearray|bool|list|dict|set|frozenset|tuple|object|type|range|memoryview|Exception|BaseException|ValueError|TypeError|KeyError|IndexError|RuntimeError|OSError|StopIteration)\b'
      scope: support.type.python
    - match: '\b(?:print|len|abs|all|any|enumerate|zip|map|filter|sorted|reversed|sum|min|max|open|isinstance|issubclass|getattr|setattr|hasattr|super|iter|next|repr|round|input|format|id|hash|vars|dir|callable)\b(?=\s*\()'
      scope: support.function.builtin.python
    - match: '\b(?:0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d+)?[jJ]?)'
      scope: constant.numeric.python
    - match: '\b{{ident}}(?=\s*\()'
      scope: variable.function.python
    - match: '\*\*=?|//=?|->|:=|[-+*/%<>=!&|^~]=?'
      scope: keyword.operator.python

  strings:
    - match: '{{fmt}}"""'
      push: f_triple_double
    - match: "{{fmt}}'''"
      push: f_triple_single
    - match: '{{fmt}}"'
      push: f_double
    - match: "{{fmt}}'"
      push: f_single
    - match: '{{raw}}"""'
      push: raw_triple_double
    - match: "{{raw}}'''"
      push: raw_triple_single
    - match: '{{raw}}"'
      push: raw_double
    - match: "{{raw}}'"
      push: raw_single
    - match: '{{plain}}"""'
      push: triple_double
    - match: "{{plain}}'''"
      push: triple_single
    - match: '{{plain}}"'
      push: double
    - match: "{{plain}}'"
      push: single

  escapes:
    - match: '\\(?:x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}|N\{[^}\n]*\}|[0-7]{1,3}|.)'
      scope: constant.character.escape.python

  interpolation:
    - match: '\{\{|\}\}'
      scope: constant.character.escape.python
    - match: '\{'
      push: f_expr

  f_expr:
    - meta_scope: meta.interpolation.python variable.parameter.interpolation.python
    - match: '\}'
      pop: true
    - match: '\{'
      push: f_expr
    - include: main

  triple_double:
    - meta_scope: string.quoted.double.block.python
    - match: '"""'
      pop: true
    - include: escapes
  triple_single:
    - meta_scope: string.quoted.single.block.python
    - match: "'''"
      pop: true
    - include: escapes
  double:
    - meta_scope: string.quoted.double.python
    - match: '"|$'
      pop: true
    - include: escapes
  single:
    - meta_scope: string.quoted.single.python
    - match: "'|$"
      pop: true
    - include: escapes

  raw_triple_double:
    - meta_scope: string.quoted.double.block.raw.python
    - match: '"""'
      pop: true
    - match: '\\.'
  raw_triple_single:
    - meta_scope: string.quoted.single.block.raw.python
    - match: "'''"
      pop: true
    - match: '\\.'
  raw_double:
    - meta_scope: string.quoted.double.raw.python
    - match: '"|$'
      pop: true
    - match: '\\.'
  raw_single:
    - meta_scope: string.quoted.single.raw.python
    - match: "'|$"
      pop: true
    - match: '\\.'

  f_triple_double:
    - meta_scope: string.quoted.double.block.format.python
    - match: '"""'
      pop: true
    - include: escapes
    - include: interpolation
  f_triple_single:
    - meta_scope: string.quoted.single.block.format.python
    - match: "'''"
      pop: true
    - include: escapes
    - include: interpolation
  f_double:
    - meta_scope: string.quoted.double.format.python
    - match: '"|$'
      pop: true
    - include: escapes
    - include: interpolation
  f_single:
    - meta_scope: string.quoted.single.format.python
    - match: "'|$"
      pop: true
    - include: escapes
    - include: interpolation
