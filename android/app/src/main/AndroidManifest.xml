<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capture Context: where a Note was captured. Read only while the
         app is open; matched against Named Places on the phone. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Voice Notes: the microphone records only while the user records
         one, and the recording stays in the Note on the user's own
         devices. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- The one download of the speech model for Transcripts (ADR 0007),
         only when the user asks for it on the speech model page, and
         only from Old Brain Fix's own GitHub release; and sync with the
         paired Devices on the local network, found there by mDNS, also
         in the background about every 15 minutes (ADR 0003). Nothing
         else goes online: no analytics, no telemetry, no other host. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Capture Context, each only once the user switched it on: the
         calendar event running and the connected Bluetooth device. Read
         at Capture and kept in the Note on the user's own devices. -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <!-- The calendar mirror, only once the user switched it on: Routines
         and Reminders written into the one calendar the user chose.
         Only events the app wrote there are ever changed or removed. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <!-- Alarms on the minute (ADR 0004): special access the user grants in
         the setup. Not USE_EXACT_ALARM, which Google Play keeps for alarm
         clocks and calendars; without the grant alarms are inexact. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Full-screen alarms for Escalation, granted by the user from
         Android 14 on. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Escalation rings with sound from a foreground service, keeping the
         phone awake while it rings. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- The App Lock and the Area Locks unlock with biometrics or the
         screen lock as well as with their PIN. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Android's Auto Backup to the user's Google account (ADR 0010):
         the agent backs up nothing until the user opts in, and then only
         the encrypted Backup file, never the database. -->
    <application
        android:label="Old Brain Fix"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:backupAgent=".AutoBackupAgent"
        android:fullBackupOnly="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Long-press the icon: voice, text and photo Capture. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- The share target: images, text and links from other apps. It
             only hands the share over to MainActivity. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- Sync bundles (ADR 0003) and Sent Items (ADR 0009) opened with
             the app or shared to it from a messenger or a file manager.
             Messengers rarely keep their own types, so files and zips are
             taken too; the app tells them apart by what is in them, and
             one that is neither is announced as such. It only copies the
             file and hands over to MainActivity, which imports a bundle
             and shows a Sent Item's preview. -->
        <activity
            android:name=".BundleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/bundle_import"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.oldbrainfix.sync" />
                <data android:mimeType="application/vnd.oldbrainfix.item" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity>
        <!-- Voice, text and photo Capture for app shortcuts and
             hardware-button mappers. Each only hands over to MainActivity,
             which opens the capture screen. -->
        <activity
            android:name=".VoiceCaptureActivity"
            android:label="@string/capture_voice"
            android:icon="@drawable/ic_shortcut_voice"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".TextCaptureActivity"
            android:label="@string/capture_text"
            android:icon="@drawable/ic_shortcut_text"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".PhotoCaptureActivity"
            android:label="@string/capture_photo"
            android:icon="@drawable/ic_shortcut_photo"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Quick Settings tiles for voice, text and photo Capture. On the
             lock screen Android asks to unlock first. -->
        <service
            android:name=".VoiceCaptureTile"
            android:label="@string/capture_voice"
            android:icon="@drawable/ic_capture_voice"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".TextCaptureTile"
            android:label="@string/capture_text"
            android:icon="@drawable/ic_capture_text"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".PhotoCaptureTile"
            android:label="@string/capture_photo"
            android:icon="@drawable/ic_capture_photo"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Home-screen widgets: one capture button each, and all three
             side by side. -->
        <receiver
            android:name=".VoiceCaptureWidget"
            android:label="@string/capture_voice"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_capture_voice" />
        </receiver>
        <receiver
            android:name=".TextCaptureWidget"
            android:label="@string/capture_text"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_capture_text" />
        </receiver>
        <receiver
            android:name=".PhotoCaptureWidget"
            android:label="@string/capture_photo"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_capture_photo" />
        </receiver>
        <receiver
            android:name=".CaptureBarWidget"
            android:label="@string/capture_all"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_capture_bar" />
        </receiver>
        <!-- The Agenda widget: today's Occurrences to check off and the
             Unsorted count. It shows what the app hands over and queues a
             Done like a notification's. -->
        <receiver
            android:name=".AgendaWidget"
            android:label="@string/agenda_widget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda" />
        </receiver>
        <!-- Lets the camera app write the photo being taken, and the app
             the user picks read a file shared with it, and nothing else. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".RearmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".RingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- The apps a share may come from, to show a shared-in Note's
             source app by its name. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The camera app that takes photos for the capture screen. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- The browser and mail app the About page's links open in. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
