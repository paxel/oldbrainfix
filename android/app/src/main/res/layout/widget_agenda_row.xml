<?xml version="1.0" encoding="utf-8"?>
<!-- One Occurrence in the Agenda widget: the box that checks it off, its
     time and its Note's first line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_row"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_agenda_row_background"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/agenda_check"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_check" />
    <TextView
        android:id="@+id/agenda_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp"
        android:maxLines="1"
        android:textColor="@color/agenda_widget_accent"
        android:textSize="13sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/agenda_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/agenda_widget_text"
        android:textSize="14sp" />
</LinearLayout>
