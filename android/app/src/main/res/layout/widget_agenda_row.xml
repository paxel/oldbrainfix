<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the Agenda widget with a box or without: an Occurrence, a
     Line, a Frog, a Missed Occurrence, a Shopping List's or a Checklist's
     row, or an appointment with its calendar's colour down its side. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:paddingBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:background="@drawable/widget_agenda_row_background"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <View
            android:id="@+id/agenda_strip"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/agenda_widget_accent"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/agenda_check"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_check" />
        <TextView
            android:id="@+id/agenda_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:maxLines="1"
            android:textColor="@color/agenda_widget_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/agenda_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/agenda_widget_text"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
