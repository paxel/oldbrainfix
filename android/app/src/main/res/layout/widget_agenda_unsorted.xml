<?xml version="1.0" encoding="utf-8"?>
<!-- The Unsorted count in the Agenda widget, which opens the Unsorted
     list. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="4dp">
    <TextView
        android:id="@+id/agenda_unsorted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_agenda_row_background"
        android:drawableEnd="@drawable/ic_widget_unsorted"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:textColor="@color/agenda_widget_accent"
        android:textSize="14sp"
        android:textStyle="bold" />
</FrameLayout>
