<?xml version="1.0" encoding="utf-8"?>
<!-- The Agenda widget: what the Agenda shows for today, as a list that
     scrolls (rows from AgendaWidgetService), and the message shown while
     the list is empty, before the app handed anything over. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_agenda_background"
    android:padding="8dp">
    <ListView
        android:id="@+id/agenda_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbarStyle="outsideOverlay" />
    <TextView
        android:id="@+id/agenda_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/agenda_widget_open_app"
        android:textColor="@color/agenda_widget_text_dim"
        android:textSize="14sp" />
</FrameLayout>
